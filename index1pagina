<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Es Garrigó · Arrocería · Sa Vileta, Palma</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;700;900&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --rice:#F2EAD3;
  --rice2:#E8DEC4;
  --rice3:#D9CEB0;
  --verde:#1B4332;
  --verde2:#2D6A4F;
  --verde-pale:#B7D5C4;
  --fire:#D4541A;
  --fire2:#E8803A;
  --fire-pale:#F5C9A8;
  --ink:#0D1F0E;
  --text:#1A2E1A;
  --muted:#5C7A60;
  --border:rgba(27,67,50,0.15);
  --border-f:rgba(212,84,26,0.2);
}
html{scroll-behavior:smooth;scroll-padding-top:0}
body{font-family:'DM Sans',sans-serif;background:var(--rice);color:var(--text);overflow-x:hidden}

/* ── HERO FULL SCREEN ── */
.hero{
  height:100vh;min-height:600px;position:relative;overflow:hidden;
  display:flex;flex-direction:column;justify-content:flex-end;
}
.hero-bg{
  position:absolute;inset:0;
  background:url('https://i.imgur.com/hrQqTba.png') center/cover;
  animation:zoom 25s ease-in-out infinite alternate;
}
@keyframes zoom{from{transform:scale(1)}to{transform:scale(1.08)}}
.hero-grad{position:absolute;inset:0;background:linear-gradient(to top,rgba(13,31,14,0.97) 0%,rgba(13,31,14,0.5) 55%,rgba(13,31,14,0.1) 100%)}
.hero-grad2{position:absolute;inset:0;background:linear-gradient(to right,rgba(13,31,14,0.4) 0%,transparent 50%)}

/* NAV over hero */
.nav-hero{
  position:fixed;top:0;left:0;right:0;z-index:200;
  padding:0 3rem;height:70px;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(13,31,14,0.0);
  backdrop-filter:blur(0px);
  border-bottom:1px solid transparent;
  transition:background .4s,backdrop-filter .4s,border-color .4s;
}
.nav-hero.scrolled{
  background:rgba(13,31,14,0.95);
  backdrop-filter:blur(16px);
  border-bottom:1px solid rgba(212,84,26,0.2);
}
.nav-logo{
  font-family:'Unbounded',sans-serif;font-size:1.1rem;font-weight:700;
  color:#fff;text-decoration:none;letter-spacing:1px;
  display:flex;align-items:center;gap:10px;flex-shrink:0;
}
.nav-logo span{
  width:32px;height:32px;border-radius:50%;
  background:var(--fire);display:flex;align-items:center;justify-content:center;
  font-size:0.9rem;flex-shrink:0;
}
.nav-links-hero{display:flex;gap:2.5rem;list-style:none}
.nav-links-hero a{
  font-family:'DM Sans',sans-serif;font-size:0.8rem;font-weight:500;
  color:rgba(255,255,255,0.7);text-decoration:none;letter-spacing:1px;
  text-transform:uppercase;transition:color .2s;
}
.nav-links-hero a:hover{color:#fff}
.btn-nav-res{
  background:var(--fire);color:#fff;
  font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;
  padding:0.6rem 1.4rem;border-radius:40px;text-decoration:none;
  letter-spacing:0.5px;transition:background .2s;flex-shrink:0;
}
.btn-nav-res:hover{background:var(--fire2)}
.ham-hero{display:none;background:none;border:1px solid rgba(255,255,255,0.3);color:#fff;
  width:38px;height:38px;border-radius:8px;cursor:pointer;font-size:1rem;
  align-items:center;justify-content:center;flex-shrink:0}
.mob-nav{display:none;flex-direction:column;position:fixed;top:70px;left:0;right:0;
  background:rgba(13,31,14,0.98);backdrop-filter:blur(16px);padding:1rem 1.5rem 1.5rem;gap:0.2rem;z-index:199;
  border-bottom:1px solid rgba(212,84,26,0.2)}
.mob-nav.open{display:flex}
.mob-nav a{font-size:0.9rem;color:rgba(255,255,255,0.7);text-decoration:none;
  padding:0.7rem 0;border-bottom:1px solid rgba(255,255,255,0.08)}
.mob-nav a:last-child{border-bottom:none;color:var(--fire2)}
.mob-nav a:hover{color:#fff}
@media(max-width:860px){.nav-links-hero{display:none}.ham-hero{display:flex!important}.nav-hero{padding:0 1.2rem}}
.hero{padding-top:0}

/* HERO CONTENT */
.hero-content{
  position:relative;z-index:10;
  padding:0 3rem 4rem;
  display:grid;grid-template-columns:1fr auto;
  align-items:flex-end;gap:3rem;
}
.hero-left{}
.hero-kicker{
  font-family:'DM Sans',sans-serif;font-size:0.68rem;letter-spacing:5px;
  text-transform:uppercase;color:var(--fire2);margin-bottom:1.5rem;
  display:flex;align-items:center;gap:12px;
}
.hero-kicker::before{content:'';display:block;width:30px;height:1px;background:var(--fire2)}
.hero-h1{
  font-family:'Unbounded',sans-serif;
  font-size:clamp(2.5rem,7vw,7rem);
  font-weight:900;line-height:0.9;
  color:#fff;letter-spacing:-2px;
  margin-bottom:1.5rem;
  text-transform:uppercase;
}
.hero-h1 .line2{color:var(--fire2)}
.hero-desc{
  font-family:'Fraunces',serif;font-style:italic;font-size:1.1rem;font-weight:300;
  color:rgba(255,255,255,0.65);line-height:1.6;max-width:480px;margin-bottom:2rem;
}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap}
.btn-fire{
  background:var(--fire);color:#fff;
  font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;
  padding:0.9rem 2rem;border-radius:40px;text-decoration:none;
  display:inline-flex;align-items:center;gap:8px;letter-spacing:0.5px;
  transition:background .2s,transform .15s;
}
.btn-fire:hover{background:var(--fire2);transform:translateY(-2px)}
.btn-ghost-w{
  background:transparent;color:#fff;
  font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;
  padding:0.9rem 2rem;border-radius:40px;text-decoration:none;
  display:inline-flex;align-items:center;gap:8px;
  border:1px solid rgba(255,255,255,0.3);letter-spacing:0.5px;
  transition:border-color .2s,background .2s;
}
.btn-ghost-w:hover{border-color:#fff;background:rgba(255,255,255,0.08)}

.hero-stats-col{
  display:flex;flex-direction:column;gap:1.5rem;align-items:flex-end;
  padding-bottom:0.5rem;
}
.hs{text-align:right}
.hs-n{font-family:'Unbounded',sans-serif;font-size:2.5rem;font-weight:700;color:var(--fire2);line-height:1}
.hs-l{font-size:0.6rem;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-top:2px}
.hs-div{width:1px;height:20px;background:rgba(255,255,255,0.15);margin-left:auto}
@media(max-width:768px){.hero-content{grid-template-columns:1fr;padding:0 1.5rem 3rem}.hero-stats-col{display:none}}

/* ── INTRO BAND ── */
.intro-band{
  background:var(--verde);
  display:grid;grid-template-columns:1fr 1fr 1fr;
  border-bottom:3px solid var(--fire);
}
.ib-item{
  padding:2rem;border-right:1px solid rgba(255,255,255,0.08);
  display:flex;align-items:center;gap:1rem;
  transition:background .2s;cursor:default;
}
.ib-item:last-child{border-right:none}
.ib-item:hover{background:rgba(255,255,255,0.05)}
.ib-icon{font-size:1.5rem;flex-shrink:0}
.ib-text{}
.ib-title{font-family:'Unbounded',sans-serif;font-size:0.7rem;font-weight:700;color:#fff;letter-spacing:1px;text-transform:uppercase}
.ib-sub{font-size:0.75rem;color:rgba(255,255,255,0.5);margin-top:2px}
@media(max-width:768px){.intro-band{grid-template-columns:1fr}.ib-item{border-right:none;border-bottom:1px solid rgba(255,255,255,0.08)}}

/* ── FEATURED ARROCES ── */
.arroces-section{background:var(--rice);padding:6rem 0}
.wrap{max-width:1300px;margin:0 auto;padding:0 3rem}
.section-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:4rem;flex-wrap:wrap;gap:1.5rem}
.sh-left{}
.sh-kicker{font-family:'DM Sans',sans-serif;font-size:0.65rem;letter-spacing:4px;text-transform:uppercase;color:var(--fire);margin-bottom:0.5rem}
.sh-title{font-family:'Unbounded',sans-serif;font-size:clamp(1.8rem,4vw,3.5rem);font-weight:900;color:var(--ink);line-height:0.95;text-transform:uppercase;letter-spacing:-1px}
.sh-sub{font-size:0.88rem;color:var(--muted);font-weight:300;line-height:1.6;max-width:380px;margin-top:0.8rem}

/* ARROCES MASONRY-LIKE */
.arroces-layout{display:grid;grid-template-columns:1.4fr 1fr;gap:2px;background:var(--border)}
.arroz-big{position:relative;overflow:hidden;grid-row:span 2}
.arroz-big img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(0.85);transition:transform .7s,filter .4s}
.arroz-big:hover img{transform:scale(1.04);filter:saturate(1)}
.arroz-small{position:relative;overflow:hidden;aspect-ratio:4/3}
.arroz-small img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(0.85);transition:transform .7s,filter .4s}
.arroz-small:hover img{transform:scale(1.04);filter:saturate(1)}
.arroz-overlay{
  position:absolute;bottom:0;left:0;right:0;
  background:linear-gradient(to top,rgba(13,31,14,0.95) 0%,rgba(13,31,14,0.3) 60%,transparent 100%);
  padding:2rem;
}
.arroz-num{font-family:'Unbounded',sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--fire2);margin-bottom:0.4rem}
.arroz-name{font-family:'Fraunces',serif;font-style:italic;font-size:1.6rem;color:#fff;line-height:1.1;margin-bottom:0.4rem}
.arroz-big .arroz-name{font-size:2.5rem}
.arroz-desc{font-size:0.78rem;color:rgba(255,255,255,0.65);line-height:1.5;margin-bottom:0.6rem}
.arroz-price{font-family:'Unbounded',sans-serif;font-size:0.85rem;font-weight:700;color:var(--fire2)}
@media(max-width:768px){.arroces-layout{grid-template-columns:1fr}.arroz-big{grid-row:span 1;aspect-ratio:4/3}}

/* ── TICKER ── */
.ticker{overflow:hidden;background:var(--fire);padding:0.7rem 0}
.ticker-track{display:flex;width:max-content;animation:tick 30s linear infinite}
.ticker-track:hover{animation-play-state:paused}
.ti{font-family:'Unbounded',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.9);white-space:nowrap;padding:0 3rem;display:flex;align-items:center;gap:1.5rem}
.ti::after{content:'✦';font-size:0.5rem}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── FUSION SECTION ── */
.fusion-section{background:var(--ink);position:relative;overflow:hidden}
.fusion-section::before{content:'';position:absolute;top:-200px;right:-200px;width:600px;height:600px;border-radius:50%;background:rgba(212,84,26,0.06);pointer-events:none}
.fusion-inner{position:relative;z-index:1}
.fusion-layout{display:grid;grid-template-columns:1fr 1fr;min-height:80vh}
.fusion-img-col{position:relative;overflow:hidden}
.fusion-img-col img{width:100%;height:100%;object-fit:cover;filter:saturate(0.7);display:block}
.fusion-img-col::after{content:'';position:absolute;inset:0;background:linear-gradient(to right,transparent 60%,var(--ink) 100%)}
.fusion-text-col{padding:5rem 4rem;display:flex;flex-direction:column;justify-content:center}
.fusion-kicker{font-family:'DM Sans',sans-serif;font-size:0.62rem;letter-spacing:4px;text-transform:uppercase;color:var(--fire2);margin-bottom:1rem}
.fusion-title{font-family:'Unbounded',sans-serif;font-size:clamp(1.6rem,3.5vw,3rem);font-weight:900;color:#fff;line-height:0.95;text-transform:uppercase;letter-spacing:-1px;margin-bottom:1.5rem}
.fusion-title span{color:var(--fire2)}
.fusion-text{font-family:'Fraunces',serif;font-style:italic;font-size:1.05rem;font-weight:300;color:rgba(255,255,255,0.55);line-height:1.75;margin-bottom:2.5rem}
.fusion-pills{display:flex;flex-wrap:wrap;gap:0.6rem;margin-bottom:2.5rem}
.fpill{
  background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);
  color:rgba(255,255,255,0.7);font-size:0.72rem;font-weight:500;
  padding:0.45rem 1rem;border-radius:40px;display:flex;align-items:center;gap:6px;
  transition:background .2s;
}
.fpill:hover{background:rgba(255,255,255,0.1)}
.fpill i{color:var(--fire2);font-size:0.7rem}
@media(max-width:860px){.fusion-layout{grid-template-columns:1fr}.fusion-img-col{height:300px}.fusion-img-col::after{display:none}.fusion-text-col{padding:3rem 1.5rem}}

/* ── HISTORIA ── */
.historia-section{background:var(--rice2);padding:6rem 0}
.historia-layout{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}
.historia-visual{position:relative}
.hist-img-main{width:100%;display:block;filter:saturate(0.8)}
.hist-img-accent{position:absolute;bottom:-3rem;right:-3rem;width:55%;border:6px solid var(--rice2);filter:saturate(0.75)}
.hist-badge{
  position:absolute;top:-1.5rem;left:-1.5rem;
  width:90px;height:90px;border-radius:50%;
  background:var(--fire);display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;
}
.hist-badge-n{font-family:'Unbounded',sans-serif;font-size:1.6rem;font-weight:900;color:#fff;line-height:1}
.hist-badge-l{font-family:'DM Sans',sans-serif;font-size:0.5rem;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.7)}
.historia-text{}
.hist-kicker{font-size:0.65rem;letter-spacing:4px;text-transform:uppercase;color:var(--fire);margin-bottom:0.8rem}
.hist-title{font-family:'Unbounded',sans-serif;font-size:clamp(1.8rem,3.5vw,3rem);font-weight:900;color:var(--ink);line-height:0.95;text-transform:uppercase;letter-spacing:-1px;margin-bottom:1.5rem}
.hist-quote{
  font-family:'Fraunces',serif;font-style:italic;font-size:1.3rem;font-weight:300;
  color:var(--fire);border-left:3px solid var(--fire);
  padding-left:1.5rem;margin:1.5rem 0;line-height:1.4;
}
.hist-p{font-size:0.9rem;color:var(--muted);line-height:1.8;margin-bottom:1rem}
@media(max-width:860px){.historia-layout{grid-template-columns:1fr;gap:5rem}.hist-img-accent{display:none}.hist-badge{display:none}}

/* ── GALERÍA FULLWIDTH ── */
.galeria-section{background:var(--ink);padding:4rem 0}
.gal-header{padding:0 3rem;margin-bottom:2rem;display:flex;justify-content:space-between;align-items:flex-end}
.gal-title{font-family:'Unbounded',sans-serif;font-size:clamp(1.2rem,3vw,2rem);font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:-0.5px}
.gal-hint{font-size:0.72rem;color:rgba(255,255,255,0.3);letter-spacing:2px}
.gal-track{display:flex;gap:3px;overflow-x:auto;scrollbar-width:none;cursor:grab;padding:0 3px}
.gal-track::-webkit-scrollbar{display:none}
.gal-track:active{cursor:grabbing}
.gal-item{flex-shrink:0;width:300px;height:400px;overflow:hidden;position:relative}
.gal-item:nth-child(even){margin-top:2rem}
.gal-item img{width:100%;height:100%;object-fit:cover;filter:saturate(0.6) brightness(0.9);transition:filter .4s,transform .5s}
.gal-item:hover img{filter:saturate(1) brightness(1);transform:scale(1.04)}
.gal-label{position:absolute;bottom:0;left:0;right:0;padding:1.2rem;background:linear-gradient(to top,rgba(13,31,14,0.9),transparent);font-family:'Fraunces',serif;font-style:italic;font-size:0.95rem;color:#fff;opacity:0;transition:opacity .3s}
.gal-item:hover .gal-label{opacity:1}

/* ── CARTA ── */
.carta-section{background:var(--rice);padding:6rem 0}
.carta-tabs{display:flex;gap:0;overflow-x:auto;scrollbar-width:none;border-bottom:2px solid var(--border);margin-bottom:3rem}
.carta-tabs::-webkit-scrollbar{display:none}
.ctab{
  font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;
  padding:1rem 1.5rem;border:none;background:transparent;cursor:pointer;
  color:var(--muted);white-space:nowrap;border-bottom:2px solid transparent;
  margin-bottom:-2px;transition:color .2s,border-color .2s;
}
.ctab.active,.ctab:hover{color:var(--fire);border-bottom-color:var(--fire)}
.carta-panel{display:none}
.carta-panel.active{display:block}
.carta-featured{
  background:var(--verde);padding:2rem;margin-bottom:2rem;
  display:flex;justify-content:space-between;align-items:center;gap:2rem;
  border-left:4px solid var(--fire);
}
.cf-badge{font-family:'DM Sans',sans-serif;font-size:0.58rem;letter-spacing:3px;text-transform:uppercase;color:var(--fire2);margin-bottom:0.4rem}
.cf-name{font-family:'Fraunces',serif;font-style:italic;font-size:1.5rem;color:#fff}
.cf-desc{font-size:0.78rem;color:rgba(255,255,255,0.55);margin-top:0.3rem}
.cf-price{font-family:'Unbounded',sans-serif;font-size:1.2rem;font-weight:700;color:var(--fire2);white-space:nowrap;flex-shrink:0}
.carta-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:0}
.ci{display:flex;justify-content:space-between;align-items:baseline;padding:1rem 0;border-bottom:1px solid var(--border);gap:1rem}
.ci:last-child{border-bottom:none}
.ci-left{flex:1}
.ci-name{font-family:'Fraunces',serif;font-style:italic;font-size:1rem;color:var(--ink)}
.ci-desc{font-size:0.72rem;color:var(--muted);margin-top:0.15rem}
.ci-price{font-family:'Unbounded',sans-serif;font-size:0.8rem;font-weight:700;color:var(--fire);white-space:nowrap;flex-shrink:0}
.carta-cat{font-family:'Unbounded',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--verde2);margin:2rem 0 1rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border-f)}
.carta-cat:first-child{margin-top:0}
@media(max-width:600px){.carta-featured{flex-direction:column;align-items:flex-start}}

/* ── CONTACTO ── */
.contacto-section{background:var(--verde);padding:6rem 0}
.contacto-layout{display:grid;grid-template-columns:1fr 1.8fr;gap:4rem;align-items:start}
.contacto-info{}
.ci-title{font-family:'Unbounded',sans-serif;font-size:clamp(1.5rem,3vw,2.5rem);font-weight:900;color:#fff;text-transform:uppercase;letter-spacing:-0.5px;line-height:0.95;margin-bottom:0.8rem}
.ci-sub{font-family:'Fraunces',serif;font-style:italic;font-size:1rem;color:rgba(255,255,255,0.55);margin-bottom:2rem}
.ci-rows{display:flex;flex-direction:column;gap:0.8rem;margin-bottom:2rem}
.ci-row{display:flex;align-items:center;gap:12px;font-size:0.85rem;color:rgba(255,255,255,0.65)}
.ci-row i{color:var(--fire2);width:14px;flex-shrink:0}
.ci-row a{color:rgba(255,255,255,0.65);text-decoration:none;transition:color .2s}
.ci-row a:hover{color:#fff}
.horario-block{background:rgba(255,255,255,0.06);padding:1.5rem;border-left:3px solid var(--fire)}
.h-label{font-family:'DM Sans',sans-serif;font-size:0.6rem;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:0.8rem}
.h-row{display:flex;justify-content:space-between;font-size:0.82rem;padding:0.4rem 0;border-bottom:1px solid rgba(255,255,255,0.08)}
.h-row:last-child{border:none}
.h-row span:first-child{color:rgba(255,255,255,0.5)}
.h-row span:last-child{color:#fff;font-weight:500}
.h-row.closed span:last-child{color:var(--fire2)}
.mapa{border-radius:0;overflow:hidden;height:420px}
.mapa iframe{width:100%;height:100%;border:0;filter:saturate(0.4) contrast(1.2) invert(0.9)}
@media(max-width:860px){.contacto-layout{grid-template-columns:1fr}.mapa{height:260px}}

/* ── RESERVA ── */
.reserva-section{background:var(--rice2);padding:6rem 0}
.reserva-layout{display:grid;grid-template-columns:1fr 1.2fr;gap:5rem;align-items:start}
.res-left{}
.res-kicker{font-size:0.65rem;letter-spacing:4px;text-transform:uppercase;color:var(--fire);margin-bottom:0.8rem}
.res-title{font-family:'Unbounded',sans-serif;font-size:clamp(1.8rem,3.5vw,3rem);font-weight:900;color:var(--ink);text-transform:uppercase;letter-spacing:-1px;line-height:0.95;margin-bottom:1rem}
.res-desc{font-size:0.88rem;color:var(--muted);line-height:1.7;margin-bottom:2rem}
