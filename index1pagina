<script>
// COOKIES
function setCookie(v){localStorage.setItem('eg_cookies',v);document.getElementById('cookieBar').classList.remove('show')}
if(localStorage.getItem('eg_cookies')===null){setTimeout(()=>document.getElementById('cookieBar').classList.add('show'),800)}

// NAV scroll effect
window.addEventListener('scroll',function(){
  document.querySelector('.nav-hero').classList.toggle('scrolled',window.scrollY>50);
});

// MOBILE MENU
function toggleMob(){document.getElementById('mobNav').classList.toggle('open')}
function closeMob(){document.getElementById('mobNav').classList.remove('open')}

function enviarReserva(e){
  e.preventDefault();
  const n=document.getElementById('nombre').value.trim();
  const t=document.getElementById('telefono').value.trim();
  const d=document.getElementById('detalle').value.trim();
  const a=document.getElementById('arroz').value;
  const no=document.getElementById('notas').value.trim();
  if(!n||!t||!d){showToast('Completa nombre, teléfono y día');return}
  let txt=`Hola Es Garrigó! 👋%0AQuiero reservar mesa.%0A👤 *Nombre:* ${n}%0A📞 *Teléfono:* ${t}%0A🗓️ *Cuándo:* ${d}%0A`;
  if(a)txt+=`🍚 *Arroz:* ${a}%0A`;
  if(no)txt+=`📝 *Notas:* ${no}%0A`;
  window.open(`https://wa.me/34671123456?text=${txt}`,'_blank');
  document.getElementById('formReserva').reset();
  showToast('✓ Redirigiendo a WhatsApp…');
}
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3200)}

// Gallery drag
const gal=document.getElementById('galeria');
let isDown=false,startX,sl;
gal.addEventListener('mousedown',e=>{isDown=true;startX=e.pageX-gal.offsetLeft;sl=gal.scrollLeft});
gal.addEventListener('mouseleave',()=>isDown=false);
gal.addEventListener('mouseup',()=>isDown=false);
gal.addEventListener('mousemove',e=>{if(!isDown)return;e.preventDefault();gal.scrollLeft=sl-(e.pageX-gal.offsetLeft-startX)*1.5});

// CARTA TABS
document.querySelectorAll('.ctab').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.ctab').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.carta-panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-'+btn.dataset.tab).classList.add('active');
  });
});

// FAB TOP
const fabTop=document.getElementById('fabTop');
window.addEventListener('scroll',()=>fabTop.classList.toggle('show',scrollY>400));
fabTop.onclick=()=>window.scrollTo({top:0,behavior:'smooth'});

// REVEAL
const ro=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');ro.unobserve(e.target)}});
},{threshold:0.08});
document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));
</script>
